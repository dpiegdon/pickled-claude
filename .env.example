# Copy to .env, or let "pickled-claude DIR init" do it: that fills in a unique instance name,
# free ports, a random token and your uid/gid.

# Instance name. Names the container (<name>-claude-1) and must be unique per host.
# Empty = the name of the instance directory.
COMPOSE_PROJECT_NAME=

# Bearer token for the HTTP injection API on INJECT_PORT.
# Empty = HTTP injector disabled; "ssh ... inject" keeps working.
INJECT_TOKEN=

# Host ports and bind address; every instance needs its own ports.
# Defaults 30000 (SSH) and 31000 (HTTP); init picks the next free ones.
# BIND_ADDR=0.0.0.0 exposes both ports to the network. The HTTP token travels in clear text.
SSH_PORT=30000
INJECT_PORT=31000
BIND_ADDR=127.0.0.1

# Hostname inside the container (shows up in the shell prompt and the tmux status line).
CONTAINER_HOSTNAME=pickle

# Permission mode.
#   1 = claude runs with --dangerously-skip-permissions (no prompts; the container is the sandbox)
#   0 = normal permission prompts (answer them after "ssh" attach, or with "inject -k")
CLAUDE_SKIP_PERMISSIONS=1

# 1 = a restarted container picks up the conversation it was running before (claude --continue).
#     The first start has nothing to continue and begins a new conversation.
#   0 = every container start begins a new conversation.
CLAUDE_CONTINUE=1

# Extra arguments for claude, e.g.  --model opus   --verbose
# An explicit --continue/--resume here takes precedence over CLAUDE_CONTINUE.
CLAUDE_ARGS=

# Authentication. Leave both empty to log in once interactively (ssh in, run /login).
# CLAUDE_CODE_OAUTH_TOKEN comes from `claude setup-token` on a machine where you are logged in.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# 1 = keep the claude version baked into the image (update by rebuilding the image).
DISABLE_AUTOUPDATER=

# uid/gid of the in-container user, unique per instance and different from your own, so an
# instance can touch neither another instance's files nor yours. init picks the next free id
# from 30000 (no host user or group, no other instance). Files the instance writes into its
# directory belong to this id. Build arguments: "pickled-claude DIR up" rebuilds.
UID=30000
GID=30000

# One extra SSH public key (single line). For several keys edit ./authorized_keys instead.
AUTHORIZED_KEYS=

# Seconds between pasting a prompt and pressing Enter. Raise it if injected prompts
# show up in the input box but are not submitted.
INJECT_ENTER_DELAY=0.5

TZ=Europe/Berlin
