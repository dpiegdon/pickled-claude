#!/bin/bash
# Manage pickled-claude instances.
#
#   pickled-claude INSTANCE init           create the instance directory and its settings
#   pickled-claude INSTANCE up [ARGS...]   build its images and (re)start it, then show info
#   pickled-claude INSTANCE build [ARGS]   build its base image (ARGS: --pull, --no-cache, ...),
#                                          then the image on top
#   pickled-claude INSTANCE info           name, state, port mapping, images
#   pickled-claude INSTANCE ssh [ARGS...]  ssh into it (no ARGS: attach to Claude)
#   pickled-claude INSTANCE delete [--yes] remove its container, images and directory (alias: rm)
#   pickled-claude INSTANCE COMPOSE...     any other docker compose command: logs -f, down, ps, ...
#   pickled-claude ls                      list known instances
#
# INSTANCE is a directory, relative to where you are or absolute, holding .env, authorized_keys,
# image/Dockerfile, workspace/ and .volume_*/. It has its own images too: <name>-base from this
# repository, <name>-claude from its image/Dockerfile on top. Nothing is shared with other
# instances. The code stays in the repository this script lives in.
set -euo pipefail

usage() { sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; }
die() { echo "pickled-claude: $*" >&2; exit 1; }

REPO=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
REGISTRY="${PICKLED_CLAUDE_REGISTRY:-${XDG_CONFIG_HOME:-$HOME/.config}/pickled-claude/instances}"
VOLUME_DIRS=(.volume_commandhistory .volume_config .volume_sessions .volume_ssh_hostkeys workspace)

# Last value of KEY in an env file, surrounding quotes removed.
env_get() {
    local value
    value=$(sed -n "s/^$1=//p" "$2" 2>/dev/null | tail -n 1)
    value=${value%\"}; value=${value#\"}; value=${value%\'}; value=${value#\'}
    printf '%s' "$value"
}

# What compose accepts as a project name: lowercase letters, digits, "-" and "_".
sanitize_name() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9_-]/-/g; s/^[^a-z0-9]*//'
}

project_name() {
    local name
    name=$(env_get COMPOSE_PROJECT_NAME "$1/.env")
    [ -n "$name" ] || name=$(sanitize_name "$(basename "$1")")
    printf '%s' "$name"
}

register() {
    mkdir -p "$(dirname "$REGISTRY")"
    touch "$REGISTRY"
    grep -qxF "$1" "$REGISTRY" || printf '%s\n' "$1" >> "$REGISTRY"
}

# Instance directories: the registry plus containers started from this repository's compose
# file (that covers instances run with plain "docker compose"). Only those with a .env count.
instances() {
    {
        [ -r "$REGISTRY" ] && cat "$REGISTRY"
        docker ps -a --filter "label=com.docker.compose.project.config_files=$REPO/compose.yaml" \
            --format '{{.Label "com.docker.compose.project.working_dir"}}' 2>/dev/null || true
    } | awk 'NF && !seen[$0]++' | while IFS= read -r dir; do
        [ -f "$dir/.env" ] && printf '%s\n' "$dir"
    done
}

port_taken() {
    local port=$1 dir
    ss -Hltn 2>/dev/null | awk '{print $4}' | grep -q ":$port\$" && return 0
    while IFS= read -r dir; do
        [ "$(env_get SSH_PORT "$dir/.env")" = "$port" ] && return 0
        [ "$(env_get INJECT_PORT "$dir/.env")" = "$port" ] && return 0
    done < <(instances)
    return 1
}

free_port() {
    local port=$1
    while port_taken "$port"; do port=$((port + 1)); done
    printf '%s' "$port"
}

name_taken() {
    local name=$1 dir
    docker compose ls -a --format json 2>/dev/null | grep -q "\"Name\":\"$name\"" && return 0
    while IFS= read -r dir; do
        [ "$(project_name "$dir")" = "$name" ] && return 0
    done < <(instances)
    return 1
}

cmd_init() {
    local dir=$1 name base n token
    mkdir -p "$dir"
    dir=$(cd "$dir" && pwd -P)

    if [ -f "$dir/.env" ]; then
        echo ".env exists, left unchanged"
    else
        base=$(sanitize_name "$(basename "$dir")")
        case "$base" in pickled-claude*) name=$base ;; *) name=pickled-claude-$base ;; esac
        n=2; base=$name
        while name_taken "$name"; do name=$base-$n; n=$((n + 1)); done

        local ssh_port inject_port
        ssh_port=$(free_port 2222)
        inject_port=$(free_port 8080)
        token=$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')

        sed -e "s|^COMPOSE_PROJECT_NAME=.*|COMPOSE_PROJECT_NAME=$name|" \
            -e "s|^SSH_PORT=.*|SSH_PORT=$ssh_port|" \
            -e "s|^INJECT_PORT=.*|INJECT_PORT=$inject_port|" \
            -e "s|^INJECT_TOKEN=.*|INJECT_TOKEN=$token|" \
            -e "s|^UID=.*|UID=$(id -u)|" \
            -e "s|^GID=.*|GID=$(id -g)|" \
            "$REPO/.env.example" > "$dir/.env"
        chmod 600 "$dir/.env"
        echo "created .env: instance $name, SSH port $ssh_port, HTTP port $inject_port," \
             "random INJECT_TOKEN, UID/GID $(id -u)/$(id -g)"
    fi

    if [ ! -s "$dir/authorized_keys" ]; then
        : > "$dir/authorized_keys"
        local key
        for key in ~/.ssh/id_ed25519.pub ~/.ssh/id_ecdsa.pub ~/.ssh/id_rsa.pub; do
            if [ -f "$key" ]; then cat "$key" >> "$dir/authorized_keys"; fi
        done
        if [ -s "$dir/authorized_keys" ]; then
            echo "authorized_keys: $(wc -l < "$dir/authorized_keys") public key(s) copied from ~/.ssh"
        else
            echo "WARNING: no public key found in ~/.ssh. Put one into $dir/authorized_keys before starting."
        fi
    else
        echo "authorized_keys exists, left unchanged"
    fi

    # Created here, owned by you; otherwise dockerd would create them as root.
    (cd "$dir" && mkdir -p "${VOLUME_DIRS[@]}" image)
    # An instance is state, not source: keep it out of whatever git repository it sits in
    # (repositories inside workspace/ are not affected).
    [ -e "$dir/.gitignore" ] || printf '# pickled-claude instance: not for the surrounding git repository\n*\n' > "$dir/.gitignore"
    if [ ! -f "$dir/image/Dockerfile" ]; then
        cat > "$dir/image/Dockerfile" <<'DOCKERFILE'
# This instance's image: the pickled-claude base image (the repository's Dockerfile, built
# for this instance only) plus whatever this instance needs. COPY takes files from this
# directory. Rebuild and restart with "pickled-claude INSTANCE up".
ARG BASE=pickled-claude-base
FROM ${BASE}

# RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client \
#     && apt-get clean && rm -rf /var/lib/apt/lists/*
# COPY some-tool /usr/local/bin/
# RUN runuser -u claude -- pip install --user --break-system-packages some-package
DOCKERFILE
        echo "image/Dockerfile: created, add this instance's packages there"
    else
        echo "image/Dockerfile exists, left unchanged"
    fi
    register "$dir"

    local me inst
    me=$(printf '%q' "$0"); inst=$(printf '%q' "$INSTANCE_ARG")
    cat <<MSG

Next:
  start:   $me $inst up
  watch:   $me $inst logs -f      (until "tmux session 'claude' started")
  attach:  $me $inst ssh          (Ctrl-b d detaches)
MSG
}

cmd_ls() {
    local dir name state
    printf '%-28s %-6s %-6s %-10s %s\n' NAME SSH HTTP STATE DIRECTORY
    while IFS= read -r dir; do
        name=$(project_name "$dir")
        state=$(docker ps -a --filter "label=com.docker.compose.project=$name" \
                    --filter "label=com.docker.compose.service=claude" --format '{{.State}}' 2>/dev/null | head -n 1 || true)
        printf '%-28s %-6s %-6s %-10s %s\n' "$name" \
            "$(env_get SSH_PORT "$dir/.env")" "$(env_get INJECT_PORT "$dir/.env")" \
            "${state:--}" "$dir"
    done < <(instances)
}

require_instance() {
    [ -f "$INSTANCE/.env" ] || die "$INSTANCE_ARG is not an instance (no .env); create it with: $0 $INSTANCE_ARG init"
    register "$INSTANCE"
}

claude_container() {    # docker ps filter args for the instance's claude container
    printf '%s\n' --filter "label=com.docker.compose.project=$1" \
        --filter "label=com.docker.compose.service=claude"
}

cmd_ssh() {
    require_instance
    local host port
    host=$(env_get BIND_ADDR "$INSTANCE/.env")
    case "$host" in ''|0.0.0.0|'::') host=localhost ;; esac
    port=$(env_get SSH_PORT "$INSTANCE/.env")
    # HostKeyAlias: known_hosts tracks each instance by name, not by a port another one may reuse.
    exec ssh -p "${port:-2222}" -o HostKeyAlias="$(project_name "$INSTANCE")" "claude@$host" "$@"
}

cmd_info() {
    require_instance
    local name env=$INSTANCE/.env bind ssh_port http_port host state ports filter
    name=$(project_name "$INSTANCE")
    bind=$(env_get BIND_ADDR "$env"); bind=${bind:-127.0.0.1}
    ssh_port=$(env_get SSH_PORT "$env"); ssh_port=${ssh_port:-2222}
    http_port=$(env_get INJECT_PORT "$env"); http_port=${http_port:-8080}
    case "$bind" in 0.0.0.0|'::') host=localhost ;; *) host=$bind ;; esac
    mapfile -t filter < <(claude_container "$name")
    state=$(docker ps -a "${filter[@]}" --format '{{.Status}}' 2>/dev/null | head -n 1 || true)
    ports=$(docker ps "${filter[@]}" --format '{{.Ports}}' 2>/dev/null | head -n 1 || true)

    printf '%-10s %s\n' instance "$name" directory "$INSTANCE" state "${state:-not created}"
    printf '%-10s %s\n' ports "SSH   $bind:$ssh_port -> 22     ssh -p $ssh_port claude@$host"
    if [ -n "$(env_get INJECT_TOKEN "$env")" ]; then
        printf '%-10s %s\n' "" "HTTP  $bind:$http_port -> 8080   http://$host:$http_port/  (token: INJECT_TOKEN in .env)"
    else
        printf '%-10s %s\n' "" "HTTP  $bind:$http_port -> 8080   disabled, INJECT_TOKEN is empty"
    fi
    [ -z "$ports" ] || printf '%-10s %s\n' published "$ports"
    printf '%-10s %s\n' images "$name-base, $name-claude"
}

# docker compose for this instance. In compose's interpolation the shell environment beats the
# env file, so whatever the instance's .env sets is dropped from the environment first: nothing
# exported in your shell leaks into an instance.
compose() {
    local drop=() key
    while IFS= read -r key; do drop+=(-u "$key"); done \
        < <(sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$INSTANCE/.env")
    env "${drop[@]}" PICKLED_CLAUDE_SRC="$REPO" COMPOSE_PROJECT_NAME="$(project_name "$INSTANCE")" \
        docker compose \
        -f "$REPO/compose.yaml" --project-directory "$INSTANCE" --env-file "$INSTANCE/.env" \
        -p "$(project_name "$INSTANCE")" "$@"
}

# The overlay builds FROM the base image, so the base has to be there first; compose would
# build both at once. ARGS only go to the base: the overlay rebuilds anyway when its base
# changed, and it cannot be pulled from anywhere.
cmd_build() {
    require_instance
    compose build "$@" base
    compose build claude
}

cmd_up() {
    cmd_build
    compose up -d "$@"
    echo
    cmd_info
}

cmd_delete() {
    require_instance
    local name answer
    name=$(project_name "$INSTANCE")
    [ "$INSTANCE" != "$REPO" ] || die "refusing to delete the repository itself"
    if [ "${1:-}" != --yes ]; then
        echo "This removes instance $name for good: its container, its images and the directory"
        echo "  $INSTANCE"
        echo "including workspace/, the login and all conversations."
        read -r -p "Type $name to confirm: " answer || true
        [ "$answer" = "$name" ] || die "not confirmed, nothing deleted"
    fi
    # Not fatal: an instance that never started, or whose compose setup is broken, must still
    # be deletable.
    compose down --remove-orphans || echo "pickled-claude: 'down' failed, deleting anyway" >&2
    # Files the container created as root can be beyond your reach; the instance's own base
    # image (still there at this point) clears them.
    if ! rm -rf "$INSTANCE" 2>/dev/null; then
        docker run --rm --pull never --entrypoint /bin/sh -v "$INSTANCE:/instance" "$name-base" \
            -c 'find /instance -mindepth 1 -delete'
        rm -rf "$INSTANCE"
    fi
    docker image rm "$name-claude" "$name-base" > /dev/null 2>&1 || true
    if [ -f "$REGISTRY" ]; then
        grep -vxF "$INSTANCE" "$REGISTRY" > "$REGISTRY.new" || true
        mv "$REGISTRY.new" "$REGISTRY"
    fi
    echo "deleted instance $name"
}

[ $# -gt 0 ] || { usage >&2; exit 2; }
case "$1" in
    -h|--help|help) usage; exit 0 ;;
    ls) cmd_ls; exit 0 ;;
esac
[ $# -ge 2 ] || die "missing command; usage: $0 INSTANCE init|up|info|ssh|delete|COMPOSE..."
INSTANCE_ARG=$1; shift
INSTANCE=$INSTANCE_ARG
[ -d "$INSTANCE" ] && INSTANCE=$(cd "$INSTANCE" && pwd -P)

case "$1" in
    init)   cmd_init "$INSTANCE" ;;
    up)     shift; cmd_up "$@" ;;
    build)  shift; cmd_build "$@" ;;
    info)   cmd_info ;;
    ssh)    shift; cmd_ssh "$@" ;;
    delete|rm) shift; cmd_delete "$@" ;;
    *)      require_instance; compose "$@" ;;
esac
